{
  "modality": "imu",
  "dataset_config": "configs/dataset.json",
  "model": "If_ConvTransformer_W",
  "upstream_project": "imu/conv_transformer",
  "sensor_ids": [
    "E45A",
    "E477"
  ],
  "subject_ids": null,
  "session_ids": [
    "step1",
    "step2",
    "step3",
    "step4"
  ],
  "expected_class_count": null,
  "expected_gesture_labels": null,
  "preprocessing": {
    "acceleration": "Accel_WR",
    "target_sample_rate_hz": 100,
    "lowpass_hz": 20,
    "gravity_cutoff_hz": 0.3,
    "filter_order": 3,
    "gravity_representation": "vector"
  },
  "input": {
    "num_points": 128
  },
  "screw_sampling": {
    "duration_s": 1.0
  },
  "data_quality": {
    "allow_cross_subject_overlap": true,
    "excluded_record_ids": [],
    "recording_overrides": {},
    "allow_within_subject_test_overlap": true
  },
  "model_parameters": {
    "feature_channel": 64,
    "kernel_size": 5,
    "kernel_size_grav": 3,
    "scale_num": 2,
    "feature_channel_out": 128,
    "multiheads": 1,
    "drop_rate": 0.2
  },
  "training": {
    "epochs": 50,
    "batch_size": 64,
    "learning_rate": 0.0001,
    "weight_decay": 0.001,
    "seed": 42,
    "device": "auto",
    "cpu_threads": 1,
    "deterministic": true,
    "scheduler": {
      "type": "reduce_on_plateau",
      "factor": 0.5,
      "patience": 3,
      "min_lr": 1e-06
    },
    "early_stopping_patience": 10,
    "gradient_clip_norm": 5.0,
    "save_windows": false,
    "num_workers": 0,
    "amp": true
  },
  "output_root": "runs/imu"
}
